generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(uuid())
  title     String
  goal      String   @default("")
  sprint    String   @default("")
  deadline  String   @default("")
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  columns   Column[]
  cards     Card[]
}

model Column {
  id       String @id
  name     String
  color    String
  position Int
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  @@index([boardId])
}

model Card {
  id       String @id
  text     String
  priority String
  x        Float
  y        Float
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  @@index([boardId])
}
